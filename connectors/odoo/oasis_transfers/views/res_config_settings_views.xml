<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_oasis_transfers" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.oasis.transfers</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id"
               ref="oasis_connector.res_config_settings_view_form_oasis"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='oasis_settings_block']" position="inside">
                <setting string="Transfers"
                         title="Where the Refresh button reaches OASIS.">
                    <div class="content-group">
                        <div class="mt16">
                            <label for="oasis_scan_url" string="Scan endpoint"/>
                            <field name="oasis_scan_url"
                                   placeholder="http://host.docker.internal:8710/scan"/>
                        </div>
                        <div class="mt16">
                            <label for="oasis_scan_token" string="Scan token"/>
                            <field name="oasis_scan_token" password="True"/>
                        </div>
                        <div class="mt16">
                            <label for="oasis_scan_stale_hours"
                                   string="Stale after (hours)"/>
                            <field name="oasis_scan_stale_hours"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
