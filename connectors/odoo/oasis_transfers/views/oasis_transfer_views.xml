<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- List: the review queue. Ordered by value, because the operator works
       down from the money, not down from whatever was computed first. -->
  <record id="view_oasis_transfer_suggestion_tree" model="ir.ui.view">
    <field name="name">oasis.transfer.suggestion.tree</field>
    <field name="model">oasis.transfer.suggestion</field>
    <field name="arch" type="xml">
      <tree string="Transfer suggestions" multi_edit="0"
            decoration-muted="state == 'rejected'"
            decoration-success="state == 'approved'"
            decoration-warning="is_fresh == True and state == 'new'"
            decoration-danger="is_stale == True and state == 'new'">
        <header>
          <button name="action_approve" type="object" string="Approve → draft transfer"
                  class="btn-primary"/>
          <button name="action_reject" type="object" string="Reject"/>
          <!-- Odoo cannot compute the plan itself; this asks OASIS to. Rows go
               red once the plan is older than the staleness window, because a
               queue with no age on it looks equally trustworthy at ten minutes
               and ten days old. -->
          <button name="action_refresh_suggestions" type="object"
                  string="Refresh from OASIS" class="btn-secondary"/>
        </header>
        <!-- The two jobs stay as SEPARATE rows and are never merged, even on
             the same route and SKU. A pull and a push are different decisions
             about the same stock: one says a store will run out, the other
             says capital is idle. Collapsing them would hide which reason
             drove the movement, which is the thing worth analysing. -->
        <field name="kind" string="Decision" widget="badge"
               decoration-info="kind == 'pull'" decoration-warning="kind == 'push'"/>
        <field name="product_id"/>
        <field name="categ_id" string="Category" optional="hide"/>
        <field name="from_warehouse_id" string="From"/>
        <field name="to_warehouse_id" string="To"/>
        <field name="quantity" sum="Units"/>
        <field name="uom_id" string="UoM"/>
        <field name="donor_ads" string="Donor /day" optional="show"/>
        <field name="donor_cover_label" string="Donor cover" optional="show"/>
        <field name="recipient_ads" string="Recipient /day" optional="show"/>
        <field name="recipient_cover_label" string="Recipient cover" optional="show"/>
        <field name="relief_days" string="Next delivery" optional="show"
               widget="float" digits="[12,0]"/>
        <field name="donor_days_cover" string="Donor cover (n)" optional="hide"/>
        <field name="recipient_days_cover" string="Recipient cover (n)" optional="hide"/>
        <field name="value_kes" sum="Value" widget="monetary"/>
        <field name="currency_id" invisible="1"/>
        <field name="is_fresh" string="Fresh" optional="show"/>
        <field name="computed_on" string="Computed" optional="show"/>
        <field name="is_stale" invisible="1"/>
        <field name="state"/>
        <field name="picking_id" optional="hide"/>
      </tree>
    </field>
  </record>

  <!-- Form: the argument, then the numbers. -->
  <record id="view_oasis_transfer_suggestion_form" model="ir.ui.view">
    <field name="name">oasis.transfer.suggestion.form</field>
    <field name="model">oasis.transfer.suggestion</field>
    <field name="arch" type="xml">
      <form string="Transfer suggestion">
        <header>
          <button name="action_approve" type="object" string="Approve → draft transfer"
                  class="oe_highlight" states="new"/>
          <button name="action_reject" type="object" string="Reject" states="new"/>
          <button name="action_reset" type="object" string="Back to queue" states="rejected"/>
          <button name="action_open_picking" type="object" string="Open transfer"
                  states="approved"/>
          <field name="state" widget="statusbar" statusbar_visible="new,approved"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1><field name="display_name" readonly="1"/></h1>
          </div>
          <!-- drives the banner's attrs below; Odoo requires a field to be
               present in the view before an attrs domain may reference it -->
          <field name="is_fresh" invisible="1"/>
          <field name="is_stale" invisible="1"/>
          <div class="alert alert-danger" role="alert"
               attrs="{'invisible': [('is_stale','=',False)]}">
            <strong>This plan is out of date.</strong> The stores have been
            trading since it was computed. Refresh from OASIS before approving.
          </div>
          <div class="alert alert-warning" role="alert" attrs="{'invisible': [('is_fresh','=',False)]}">
            <strong>Perishable.</strong> OASIS never queues fresh lines on its own —
            transit costs shelf life. Approve this only if it can be dispatched today.
          </div>
          <group>
            <group string="Why OASIS proposed this">
              <field name="kind"/>
              <field name="reason" nolabel="1" colspan="2" readonly="1"/>
            </group>
            <group string="Position">
              <field name="donor_ads" string="Donor sells / day"/>
              <field name="donor_cover_label" string="Donor cover"/>
              <field name="recipient_ads" string="Recipient sells / day"/>
              <field name="recipient_cover_label" string="Recipient cover"/>
              <field name="relief_days" string="Recipient's next delivery (days)"/>
              <field name="value_kes" widget="monetary"/>
              <field name="currency_id" invisible="1"/>
            </group>
          </group>
          <group>
            <group string="Movement">
              <field name="product_id"/>
              <field name="quantity"/>
              <field name="uom_id"/>
            </group>
            <group string="Route">
              <field name="from_warehouse_id"/>
              <field name="to_warehouse_id"/>
              <field name="computed_on"/>
              <field name="picking_id" readonly="1"/>
              <field name="picking_state" readonly="1"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Analysis. Pull and push are the ROWS by default, because the first
       question about any transfer plan is how much of it is preventing
       stockouts versus freeing idle capital — they are funded differently and
       judged differently. -->
  <record id="view_oasis_transfer_suggestion_pivot" model="ir.ui.view">
    <field name="name">oasis.transfer.suggestion.pivot</field>
    <field name="model">oasis.transfer.suggestion</field>
    <field name="arch" type="xml">
      <pivot string="Transfer decisions" sample="1">
        <field name="kind" type="row"/>
        <field name="to_warehouse_id" type="col"/>
        <field name="value_kes" type="measure"/>
        <field name="quantity" type="measure"/>
        <field name="recipient_ads" type="measure"/>
        <field name="relief_days" type="measure"/>
      </pivot>
    </field>
  </record>

  <record id="view_oasis_transfer_suggestion_graph" model="ir.ui.view">
    <field name="name">oasis.transfer.suggestion.graph</field>
    <field name="model">oasis.transfer.suggestion</field>
    <field name="arch" type="xml">
      <graph string="Transfer decisions" type="bar" stacked="1" sample="1">
        <field name="to_warehouse_id"/>
        <field name="kind"/>
        <field name="value_kes" type="measure"/>
      </graph>
    </field>
  </record>

  <record id="view_oasis_transfer_suggestion_search" model="ir.ui.view">
    <field name="name">oasis.transfer.suggestion.search</field>
    <field name="model">oasis.transfer.suggestion</field>
    <field name="arch" type="xml">
      <search string="Transfer suggestions">
        <field name="product_id"/>
        <field name="from_warehouse_id"/>
        <field name="to_warehouse_id"/>
        <filter name="f_new" string="To review" domain="[('state','=','new')]"/>
        <filter name="f_approved" string="Approved" domain="[('state','=','approved')]"/>
        <filter name="f_rejected" string="Rejected" domain="[('state','=','rejected')]"/>
        <separator/>
        <filter name="f_pull" string="Plug a gap" domain="[('kind','=','pull')]"/>
        <filter name="f_push" string="Clear idle stock" domain="[('kind','=','push')]"/>
        <separator/>
        <filter name="f_stale" string="Out of date" domain="[('is_stale','=',True)]"/>
        <filter name="f_current" string="Current" domain="[('is_stale','=',False)]"/>
        <separator/>
        <filter name="f_dry" string="Non-perishable" domain="[('is_fresh','=',False)]"/>
        <filter name="f_fresh" string="Perishable" domain="[('is_fresh','=',True)]"/>
        <group expand="0" string="Group by">
          <filter name="g_to" string="Receiving store" context="{'group_by':'to_warehouse_id'}"/>
          <filter name="g_from" string="Donor store" context="{'group_by':'from_warehouse_id'}"/>
          <filter name="g_kind" string="Decision (pull / push)" context="{'group_by':'kind'}"/>
          <filter name="g_categ" string="Category" context="{'group_by':'categ_id'}"/>
          <filter name="g_state" string="Status" context="{'group_by':'state'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_oasis_transfer_suggestion" model="ir.actions.act_window">
    <field name="name">Transfer suggestions</field>
    <field name="res_model">oasis.transfer.suggestion</field>
    <field name="view_mode">tree,form,pivot,graph</field>
    <field name="context">{'search_default_f_new': 1}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">No transfer suggestions yet.</p>
      <p>
        OASIS reads this Odoo instance, works out which stores will run short
        before their next delivery and which are sitting on stock that is not
        moving, and posts what it would do here for you to approve.
      </p>
      <p>
        Run a scan from OASIS to fill this queue. Approving a suggestion
        creates a <b>draft internal transfer</b> — nothing is reserved and no
        stock moves until your team confirms it in Inventory.
      </p>
    </field>
  </record>

</odoo>
