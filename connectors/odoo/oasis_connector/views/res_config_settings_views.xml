<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      THE SETTINGS SHELL ONLY — an empty OASIS section.

      It is defined here, in the base, because more than one feature module
      needs to put settings inside it and an <app> block can only be declared
      once. Each feature module xpaths its own settings into
      `oasis_settings_block` and is responsible for nothing else. A client with
      only one module installed sees only that module's settings, under one
      heading rather than several competing OASIS sections.
    -->
    <record id="res_config_settings_view_form_oasis" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.oasis</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="OASIS" string="OASIS" name="oasis_connector">
                    <block title="OASIS Retail Intelligence"
                           name="oasis_settings_block"/>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
