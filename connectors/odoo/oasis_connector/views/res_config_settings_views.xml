<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      THE SETTINGS SHELL ONLY — an empty OASIS section.

      It is defined here, in the base, because more than one feature module
      needs to put settings inside it and an <app> block can only be declared
      once. Each feature module xpaths its own settings into
      `oasis_settings_block` and is responsible for nothing else. A client with
      only one module installed sees only that module's settings, under one
      heading rather than several competing OASIS sections.
    -->
    <record id="res_config_settings_view_form_oasis" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.oasis</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="OASIS" string="OASIS" name="oasis_connector">
                    <block title="OASIS Retail Intelligence"
                           name="oasis_settings_block">
                        <!--
                          THE CONNECTION, not a feature. Every OASIS module
                          reaches the same instance and judges its queue by the
                          same staleness window, so this is declared once here
                          rather than copied into each module.
                        -->
                        <setting string="Connection"
                                 title="Where Odoo reaches OASIS to recompute a plan.">
                            <div class="content-group">
                                <div class="mt16">
                                    <label for="oasis_scan_url"
                                           string="Scan endpoint"/>
                                    <field name="oasis_scan_url"
                                           placeholder="http://host.docker.internal:8710/scan"/>
                                </div>
                                <div class="mt16">
                                    <label for="oasis_scan_token"
                                           string="Scan token"/>
                                    <field name="oasis_scan_token"
                                           password="True"/>
                                </div>
                                <div class="mt16">
                                    <label for="oasis_scan_stale_hours"
                                           string="Stale after (hours)"/>
                                    <field name="oasis_scan_stale_hours"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
