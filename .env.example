# OASIS environment configuration
# Copy to .env and fill in real values. NEVER commit .env — it is gitignored.

# --- Authentication & seeding ---
# Password used when seeding the default dashboard accounts (ops_admin,
# regional_mgr, branch_mgr, branch_mgr2, demo_user). If unset, a random
# one-time password per account is printed to the log on first seed.
OASIS_SEED_PASSWORD=
# Optional per-account override, e.g.:
# OASIS_SEED_PASSWORD_OPS_ADMIN=

# --- API security ---
# Shared key required in the X-API-Key header on all FastAPI endpoints
# (oasis/api/server.py and oasis/api/bridge.py). If unset, an ephemeral
# key is generated per run and printed to the log.
OASIS_API_KEY=
# Comma-separated list of allowed CORS origins. Defaults to localhost
# dashboard ports if unset. Never use *.
OASIS_ALLOWED_ORIGINS=http://localhost:8501,http://localhost:8550

# --- Licensing ---
# Salt used to sign/verify offline license keys. Required for licensed
# (premium) modules; without it they run in evaluation mode only.
OASIS_LICENSE_SALT=

# --- Data & paths ---
# Full database URL. Supports SQLite and PostgreSQL.
# SQLite (default): sqlite:///oasis/data/mock_pos_erp.db
# PostgreSQL:       postgresql://oasis:password@localhost:5432/oasis
# OASIS_DB_URL=
# Legacy shortcut: Override the SQLite file location (ignored if OASIS_DB_URL is set)
# OASIS_DB_PATH=
# Override the stores network JSON (default: <project root>/stores_network.json)
# OASIS_NETWORK_JSON=
# Override the data directory used by oasis/tools (default: oasis/data)
# OASIS_DATA_DIR=

# --- Logging ---
# Log verbosity: DEBUG | INFO | WARNING | ERROR (default: INFO)
# OASIS_LOG_LEVEL=INFO
# Log output format: text (human-readable) | json (for log aggregators)
# OASIS_LOG_FORMAT=text
# Optional file path for rotating log output (5 MB x 3 backups)
# OASIS_LOG_FILE=logs/oasis.log

# --- External services ---
# Anthropic API key for AI-mode replenishment analysis (falls back to the
# deterministic rule engine if unset).
ANTHROPIC_API_KEY=
# Mosaic expansion-handoff API (integrated_app.py)
# MOSAIC_API_BASE=http://127.0.0.1:8000

# --- MSSQL / iRetail bridge (only if using the live SQL pathway) ---
# MSSQL_HOST=
# MSSQL_PORT=1433
# MSSQL_DATABASE=
# MSSQL_USERNAME=
# MSSQL_PASSWORD=
